---
import FormItem from "../components/FormItem.astro";
import Base from "../layouts/Base.astro";
const pageTitle = "Submit project";
const heading = "Submit a project";
---

<Base pageTitle={pageTitle} heading={heading}>
  <div class="flex-col">
    <p class="mb-6 font-bold">
      If you've got a project you would like us to work on, please fill in the
      form below and we will get back to you as soon as possible.
    </p>

    <p class="mb-8">
      For general enquiries, please click <a
        href="/contact-us/"
        class="text-blue-500">here</a
      >.
    </p>

    <h2 class="text-2xl text-[#465786] mt-10 mb-4 ">Contact details</h2>
    <form action="https://formspree.io/f/mdaqabgd" method="POST">
      <FormItem
        type="input"
        variableID="q-full-name"
        displayText="Your name:"
      />
      <FormItem type="input" variableID="q-email" displayText="Your email:" />
      <FormItem type="input" variableID="q-institution" displayText="Your institution:" />

      <h2 class="text-2xl text-[#465786] mt-10 mb-4">Project details</h2>
      <FormItem
        type="textarea"
        variableID="q-biological-question"
        displayText="Biological question (max. 100 words):"
        defaultText="Please provide a brief explanation of the biological question you are attempting to answer."
        rows="5"
      />
      <FormItem
      type="textarea"
      variableID="q-wish-to-quantify"
      displayText="What exactly do you wish to quantify? (max. 100 words)"
      defaultText="Please list the key measurements you wish to extract from your images.  For example, cell area in control and treated samples."
      rows="5"
      />
      <FormItem
        type="textarea"
        variableID="q-technical-info"
        displayText="Technical information (max. 100 words):"
        defaultText="Please provide some information on the system used for image acquisition, number of conditions, approximate image sizes (resolution) and file format."
        rows="5"
      />
      <FormItem
        type="textarea"
        variableID="q-shortcomings"
        displayText="Are there any known shortcomings?"
        defaultText="For example, photobleaching, mechanical drift or bleedthrough between channels."
        rows="5"
      />      
      <FormItem 
        type="textarea" 
        variableID="q-file-link" 
        displayText="(Optional) Example files:" 
        defaultText="Providing one or two example files could help us assess your project.  If you have such files, please can you upload them to an online server (e.g. WeTransfer) and provide the access URL here."
        rows="5"  
      />


      <div class="flex align-center">
        <button
          type="submit"
          class="w-64 mt-10 mb-10 ml-auto mr-auto p-2 text-white rounded-2xl bg-[#465786] hover:bg-[#BE3E49] transition"
          >Submit</button
        >
      </div>
    </form>
  </div>
</Base>
